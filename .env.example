# ─────────────────────────────────────────────────────────────
# Allora — environment template
# Copy to `.env` at repo root and fill in values before `npm run dev`.
# Never commit the populated `.env` file.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL) — used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allora?schema=public

# Redis (sessions, OTP store, real-time pub/sub)
REDIS_URL=redis://localhost:6379

# JWT secrets — generate with: `openssl rand -hex 64`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP (for OTP delivery via Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Allora <no-reply@allora.app>"

# Cloudinary (image + service-page asset uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (UPI + COD QR payments — India only)
# NOTE: The web client receives the key via the /checkout response, so only
#       the server-side keys below are required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mapbox — server-side and client-side tokens
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Seed accounts (created by `npm run seed`)
ADMIN_EMAIL=admin@allora.app
PRODUCT_MANAGER_EMAIL=pm@allora.app
PAYMENT_MANAGER_EMAIL=payments@allora.app
