// Allora — Multi-Role Local Service & Delivery Platform
// Prisma schema (PostgreSQL)
//
// Conventions:
// - GeoJSON polygons stored as `Json` (validated server-side with @turf/turf).
// - Soft-delete is NOT used; use isActive flags where needed.
// - All money fields use Decimal(10,2) for INR precision.
// - Timestamps default to now() and auto-update where appropriate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
  HERO
  DELIVERY_BOY
  USER
  PRODUCT_MANAGER
  PAYMENT_MANAGER
  SECRET_SHOP
  ITEM_CATALOG
}

enum CategoryType {
  PRODUCT
  SERVICE
}

enum PaymentCondition {
  FIXED
  DYNAMIC
}

enum ServiceRadiusKm {
  KM_2
  KM_5
  KM_7
  KM_10
}

enum VerificationType {
  HERO
  DELIVERY_BOY
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  REJECTED
}

enum SecretOrderStatus {
  PLACED
  RECEIVED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum SecretOrderPaymentMode {
  COD
  ONLINE
}

enum SecretOrderPaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum SubOrderStatus {
  PENDING
  PACKED
  ASSIGNED_DELIVERY
  DELIVERED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum NotificationType {
  VERIFICATION_STATUS
  ORDER_NEW
  ORDER_STATUS
  DELIVERY_ASSIGNED
  PAYMENT_CONFIRMED
  GENERIC
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE: USER & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String   // e.g. "Home", "Office"
  address   String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id              String   @id @default(cuid())
  name            String?
  email           String   @unique
  phone           String?
  gender          String?  // MALE | FEMALE | OTHER
  role            Role     @default(USER)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  profileImageUrl String?
  passwordHash    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Profiles (one-to-one per role)
  agentProfile        AgentProfile?
  heroProfile         HeroProfile?
  deliveryBoyProfile  DeliveryBoyProfile?
  secretShopProfile   SecretShopProfile?

  // Activity
  verificationRequests VerificationRequest[] @relation("RequesterVerification")
  secretShopRequests   SecretShopRequest[]
  orders               Order[]
  serviceRequests      ServiceRequest[]
  reviews              Review[]
  bookingRatings       BookingRating[]
  reviewReactions      ReviewReaction[]
  notifications        Notification[]
  fcmTokens            FcmToken[]

  // Saved addresses
  savedAddresses    SavedAddress[]

  // Authoring (PM / PaymentManager actions)
  categoriesAdded   Category[]      @relation("CategoryAddedBy")
  productsAdded     Product[]       @relation("ProductAddedBy")
  paymentsSettled   PaymentRecord[] @relation("PaymentSettledBy")

  @@index([role])
  @@index([isActive])
}

model OTPRecord {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, used])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AREAS & AGENTS
// ─────────────────────────────────────────────────────────────────────────────

model Area {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // 20-char alphanumeric
  polygon   Json     // GeoJSON FeatureCollection / Polygon
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryForAgents    AgentProfile[] @relation("AgentPrimaryArea")
  agentAreas          AgentArea[]
  verificationRequests VerificationRequest[] @relation("VerificationRequestArea")

  @@index([name])
}

model AgentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryAreaId     String?
  primaryArea       Area?    @relation("AgentPrimaryArea", fields: [primaryAreaId], references: [id])
  isVerifiedByAdmin Boolean  @default(false)
  addedByAdminAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agentAreas              AgentArea[]
  verifiedHeroes          HeroProfile[]         @relation("HeroVerifiedByAgent")
  verifiedDeliveryBoys    DeliveryBoyProfile[]  @relation("DeliveryVerifiedByAgent")
  handledRequests         VerificationRequest[] @relation("AgentVerificationRequests")
  secretShopRequests      SecretShopRequest[]   @relation("AgentSecretShopRequests")
  verifiedSecretShops     SecretShopProfile[]   @relation("SecretShopVerifiedByAgent")
  inventoryItems          AgentInventoryItem[]
  secretOrders            SecretOrder[]         @relation("AgentSecretOrders")
  priceControls           AgentSubcategoryPricing[]
  categoryConfigs         AgentCategoryConfig[]
  slotConfig              AgentSlotConfig?
  serviceRequests         ServiceRequest[]

  @@index([primaryAreaId])
}

model AgentArea {
  id        String   @id @default(cuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([agentId, areaId])
  @@index([areaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// HERO (Service Provider)
// ─────────────────────────────────────────────────────────────────────────────

model HeroProfile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName            String?
  serviceName         String?
  // Heroes can offer services/products under MULTIPLE categories. Set by the
  // agent during verification (cannot be edited by the hero afterwards).
  categoryIds         String[]
  subcategoryIds      String[]         // denormalized; pricing rows are authoritative
  phone               String
  address             String
  locationLat         Float
  locationLng         Float
  serviceAreaPolygon  Json?            // GeoJSON polygon drawn by agent
  serviceRadius       ServiceRadiusKm  @default(KM_5)
  activeFrom          String?          // "HH:mm"
  activeTo            String?          // "HH:mm"
  workingDays         Int[]            // 0..6, Sun=0
  requiresDelivery    Boolean          @default(false)
  isVerifiedByAgent   Boolean          @default(false)
  verifiedByAgentId   String?
  verifiedByAgent     AgentProfile?    @relation("HeroVerifiedByAgent", fields: [verifiedByAgentId], references: [id])
  profileImageUrl     String?
  storePageContent    Json?            // Custom store page HTML and assets for services
  isActive            Boolean          @default(true)
  isAvailable         Boolean          @default(true)
  gender              String?
  // One-time onboarding fee tracking (paid after agent verification)
  hasPaidOnboardingFee  Boolean        @default(false)
  onboardingPaymentTxnId String?
  onboardingPaidAt      DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  pricing         HeroSubcategoryPricing[]
  heroProducts    HeroProduct[]
  orderItems      OrderItem[]
  serviceBookings ServiceBooking[]
  paymentRecords  PaymentRecord[]
  reviews         Review[]
  slots           HeroSlot[]
  serviceRequests ServiceRequest[]

  @@index([isVerifiedByAgent, isActive])
  @@index([locationLat, locationLng])
}

model HeroSubcategoryPricing {
  id                 String      @id @default(cuid())
  heroId             String
  hero               HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)
  subcategoryId      String
  subcategory        Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  serviceCharge      Decimal     @db.Decimal(10, 2)
  deliveryCharge2km  Decimal     @db.Decimal(10, 2) @default(0)
  deliveryCharge5km  Decimal     @db.Decimal(10, 2) @default(0)
  deliveryCharge7km  Decimal     @db.Decimal(10, 2) @default(0)
  deliveryCharge10km Decimal     @db.Decimal(10, 2) @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([heroId, subcategoryId])
  @@index([subcategoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DELIVERY BOY
// ─────────────────────────────────────────────────────────────────────────────

model DeliveryBoyProfile {
  id                String        @id @default(cuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String
  address           String
  locationLat       Float?
  locationLng       Float?
  purpose           String?
  isVerifiedByAgent Boolean       @default(false)
  verifiedByAgentId String?
  verifiedByAgent   AgentProfile? @relation("DeliveryVerifiedByAgent", fields: [verifiedByAgentId], references: [id])
  assignedShopIds   String[]      // HeroProfile ids
  profileImageUrl   String?
  // Optional UPI receiving address shown to users on COD orders so they can
  // pay via UPI on the doorstep instead of handing over cash.
  upiVpa            String?
  upiName           String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  orderItems     OrderItem[]
  paymentRecords PaymentRecord[]

  @@index([isVerifiedByAgent, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// VERIFICATION REQUESTS
// ─────────────────────────────────────────────────────────────────────────────

model VerificationRequest {
  id           String             @id @default(cuid())
  requestType  VerificationType
  requesterId  String
  requester    User               @relation("RequesterVerification", fields: [requesterId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        AgentProfile?      @relation("AgentVerificationRequests", fields: [agentId], references: [id])
  areaId       String?
  area         Area?              @relation("VerificationRequestArea", fields: [areaId], references: [id])
  status       VerificationStatus @default(PENDING)
  details      Json               // name, serviceName, shopName, phone, address, categoryIds, subcategoryIds, locationLat, locationLng, profileImageUrl, purpose
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, areaId])
  @@index([requesterId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id                       String           @id @default(cuid())
  name                     String
  type                     CategoryType
  imageUrl                 String?
  isActive                 Boolean          @default(true)
  addedByProductManagerId  String?
  addedByProductManager    User?            @relation("CategoryAddedBy", fields: [addedByProductManagerId], references: [id])
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  products                 Product[]
  subcategories            Subcategory[]
  agentCategoryConfigs     AgentCategoryConfig[]
  reviews                  Review[]
  bookingRatings           BookingRating[]

  @@index([type, isActive])
}

model Subcategory {
  id              String   @id @default(cuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  nameHi          String?  // Hindi name shown when user switches to हिंदी
  descriptionHi   String?  // Hindi description for bilingual service pages
  // Icon name from Lucide set (e.g. "Pizza", "Sparkles"). Stored in imageUrl for back-compat.
  imageUrl        String?
  pageContent     Json?    // { html, assets: [{name,url}], css? } — for SERVICE pages
  isActive        Boolean  @default(true)
  // Viral section pinning (admin can pin subcategories to viral grid)
  isPinned           Boolean  @default(false)
  viralPosition      Int?     // 1-6 for grid position in Most Used section (null = not shown)
  viralImageUrl      String?  // Separate image URL shown only in viral grid
  newlyAddedPosition Int?     // 1-6 for position in Newly Added section (null = not shown)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        Product[]
  pricing         HeroSubcategoryPricing[]
  agentPricing    AgentSubcategoryPricing[]
  serviceBookings ServiceBooking[]
  orderItems      OrderItem[]
  serviceRequests ServiceRequest[]

  @@index([categoryId, isActive])
  @@index([isPinned, viralPosition])
}

model Product {
  id                       String      @id @default(cuid())
  categoryId               String
  category                 Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId            String?
  subcategory              Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name                     String
  description              String?
  imageUrl                 String?
  basePrice                Decimal     @db.Decimal(10, 2)
  isReplaceable            Boolean     @default(false)
  isRefundable             Boolean     @default(false)
  isReturnable             Boolean     @default(false)
  returnWindowDays         Int         @default(0)
  isActive                 Boolean     @default(true)
  addedByProductManagerId  String?
  addedByProductManager    User?       @relation("ProductAddedBy", fields: [addedByProductManagerId], references: [id])
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  orderItems   OrderItem[]
  reviews      Review[]
  heroProducts HeroProduct[]

  @@index([categoryId, isActive])
  @@index([subcategoryId, isActive])
}

model HeroProduct {
  id                String      @id @default(cuid())
  heroId            String
  hero              HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellingPrice      Decimal     @db.Decimal(10, 2)
  isAvailable       Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([heroId, productId])
  @@index([heroId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS & PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  deliveryCharge  Decimal       @db.Decimal(10, 2) @default(0)
  razorpayOrderId String?
  razorpayPaymentId String?
  deliveryAddress String
  deliveryLat     Float
  deliveryLng     Float
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  serviceBookings ServiceBooking[]
  paymentRecords  PaymentRecord[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id                      String              @id @default(cuid())
  orderId                 String
  order                   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  heroId                  String
  hero                    HeroProfile         @relation(fields: [heroId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product?            @relation(fields: [productId], references: [id])
  subcategoryId           String?
  subcategory             Subcategory?        @relation(fields: [subcategoryId], references: [id])
  quantity                Int                 @default(1)
  unitPrice               Decimal             @db.Decimal(10, 2)
  deliveryCharge          Decimal             @db.Decimal(10, 2) @default(0)
  subOrderStatus          SubOrderStatus      @default(PENDING)
  assignedDeliveryBoyId   String?
  assignedDeliveryBoy     DeliveryBoyProfile? @relation(fields: [assignedDeliveryBoyId], references: [id])
  deliveryBoyConfirmedAt  DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([orderId])
  @@index([heroId, subOrderStatus])
  @@index([assignedDeliveryBoyId, subOrderStatus])
}

model ServiceBooking {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  heroId          String
  hero            HeroProfile   @relation(fields: [heroId], references: [id], onDelete: Cascade)
  subcategoryId   String
  subcategory     Subcategory   @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  charge          Decimal       @db.Decimal(10, 2)
  transportCharge Decimal       @db.Decimal(10, 2) @default(0)
  status          BookingStatus @default(PENDING)
  scheduledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([heroId, status])
}

model PaymentRecord {
  id                       String              @id @default(cuid())
  orderId                  String
  order                    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date                     DateTime            @db.Date
  heroId                   String
  hero                     HeroProfile         @relation(fields: [heroId], references: [id], onDelete: Cascade)
  deliveryBoyId            String?
  deliveryBoy              DeliveryBoyProfile? @relation(fields: [deliveryBoyId], references: [id])
  amountToHero             Decimal             @db.Decimal(10, 2)
  amountToDeliveryBoy      Decimal             @db.Decimal(10, 2) @default(0)
  platformFee              Decimal             @db.Decimal(10, 2) @default(0)
  isSettled                Boolean             @default(false)
  settledAt                DateTime?
  settledByPaymentManagerId String?
  settledByPaymentManager  User?               @relation("PaymentSettledBy", fields: [settledByPaymentManagerId], references: [id])
  notes                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([date, isSettled])
  @@index([heroId, date])
  @@index([deliveryBoyId, date])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEWS & NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  heroId      String?
  hero        HeroProfile? @relation(fields: [heroId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  rating      Int          // 1..5
  reviewText  String?      // max 40 words, editable
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reactions   ReviewReaction[]

  @@unique([userId, categoryId], map: "Review_userId_categoryId_key")
  @@index([heroId, createdAt])
  @@index([categoryId, createdAt])
  @@index([productId, createdAt])
}

model BookingRating {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  rating           Int            // 1..5
  createdAt        DateTime       @default(now())

  @@index([categoryId, createdAt])
  @@index([userId, categoryId])
}

model ReviewReaction {
  id        String       @id @default(cuid())
  reviewId  String
  review    Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String   // "ios" or "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

model HeroDeclinedRequest {
  id        String   @id @default(cuid())
  heroId    String
  requestId String
  createdAt DateTime @default(now())

  @@unique([heroId, requestId])
  @@index([heroId])
  @@index([requestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECRET SHOP
// ─────────────────────────────────────────────────────────────────────────────

model SecretShopProfile {
  id                String        @id @default(cuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName          String
  phone             String
  address           String
  locationLat       Float
  locationLng       Float
  isVerifiedByAgent Boolean       @default(false)
  verifiedByAgentId String?
  verifiedByAgent   AgentProfile? @relation("SecretShopVerifiedByAgent", fields: [verifiedByAgentId], references: [id])
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  orders SecretOrder[]

  @@index([isVerifiedByAgent, isActive])
}

model SecretShopRequest {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       AgentProfile?      @relation("AgentSecretShopRequests", fields: [agentId], references: [id])
  status      VerificationStatus @default(PENDING)
  shopName    String
  phone       String
  address     String
  locationLat Float
  locationLng Float
  purpose     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, agentId])
  @@index([userId])
}

model AgentSlotConfig {
  id            String       @id @default(cuid())
  agentId       String       @unique
  agent         AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  slotStartHour Int          @default(6)
  slotEndHour   Int          @default(20)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model HeroSlot {
  id           String      @id @default(cuid())
  heroId       String
  hero         HeroProfile @relation(fields: [heroId], references: [id], onDelete: Cascade)
  date         DateTime    @db.Date
  hour         Int         // 6..19  (6 = 6:00 AM, 19 = 7:00 PM)
  isBooked     Boolean     @default(false)
  isBusyByHero Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  serviceRequest ServiceRequest?

  @@unique([heroId, date, hour])
  @@index([heroId, date])
}

model ServiceRequest {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategoryId   String
  subcategory     Subcategory          @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  agentId         String
  agent           AgentProfile         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  heroId          String?
  hero            HeroProfile?         @relation(fields: [heroId], references: [id])
  slotId          String?              @unique
  slot            HeroSlot?            @relation(fields: [slotId], references: [id])
  status          ServiceRequestStatus @default(PENDING)
  charge               Decimal              @db.Decimal(10, 2)
  discountPercent      Decimal              @db.Decimal(5, 2)  @default(0) // individual service discount
  bulkDiscountPercent  Decimal              @db.Decimal(5, 2)  @default(0) // extra discount for booking multiple services
  transportCharge      Decimal              @db.Decimal(10, 2) @default(0)
  userName        String
  userPhone       String
  userGender      String?
  userAddress     String
  userLat         Float?
  userLng         Float?
  scheduledDate   DateTime             @db.Date
  scheduledHour   Int
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  bookingRating BookingRating?

  @@index([userId, createdAt])
  @@index([heroId, status])
  @@index([agentId, scheduledDate])
  @@index([subcategoryId, scheduledDate, scheduledHour])
}

model AgentSubcategoryPricing {
  id                   String       @id @default(cuid())
  agentId              String
  agent                AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  subcategoryId        String
  subcategory          Subcategory  @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  baseServiceCharge    Decimal      @db.Decimal(10, 2)
  discountPercent      Decimal      @db.Decimal(5, 2)  @default(0)
  slotDurationHours    Int          @default(1)         // 1-4 hrs; how long each booking slot takes
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([agentId, subcategoryId])
  @@index([agentId])
}

// Per-category config: transport rate and bulk-booking discounts controlled by agent
model AgentCategoryConfig {
  id                   String       @id @default(cuid())
  agentId              String
  agent                AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  categoryId           String
  category             Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transportChargePerKm Decimal      @db.Decimal(10, 2) @default(0)
  bulkDiscount2        Decimal      @db.Decimal(5, 2)  @default(0) // extra % for booking 2 services
  bulkDiscount3        Decimal      @db.Decimal(5, 2)  @default(0) // extra % for booking 3 services
  bulkDiscount4Plus    Decimal      @db.Decimal(5, 2)  @default(0) // extra % for booking 4+ services
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([agentId, categoryId])
  @@index([agentId])
}

model AgentCategory {
  id        String      @id @default(cuid())
  name      String
  imageUrl  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items AgentItem[]

  @@index([isActive])
}

model AgentItem {
  id            String         @id @default(cuid())
  categoryId    String?
  category      AgentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name          String
  brandName     String?
  imageUrl      String?
  isActive      Boolean        @default(true)
  buyCount      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  inventoryItems AgentInventoryItem[]

  @@index([isActive])
  @@index([categoryId])
}

model AgentInventoryItem {
  id            String       @id @default(cuid())
  agentId       String
  agent         AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  itemId        String
  item          AgentItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity      Int          @default(0)
  mrp           Decimal?     @db.Decimal(10, 2)
  price         Decimal      @db.Decimal(10, 2)
  specification String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orderItems SecretOrderItem[]

  @@unique([agentId, itemId])
  @@index([agentId, isActive])
}

model SecretOrder {
  id             String                   @id @default(cuid())
  shopId         String
  shop           SecretShopProfile        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  agentId        String
  agent          AgentProfile             @relation("AgentSecretOrders", fields: [agentId], references: [id])
  status         SecretOrderStatus        @default(PLACED)
  totalAmount    Decimal                  @db.Decimal(10, 2)
  notes          String?
  paymentMode    SecretOrderPaymentMode   @default(COD)
  paymentStatus  SecretOrderPaymentStatus @default(PENDING)
  paymentTxnId   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  items SecretOrderItem[]

  @@index([shopId, status])
  @@index([agentId, status])
}

model SecretOrderItem {
  id              String             @id @default(cuid())
  orderId         String
  order           SecretOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   AgentInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Int                @default(1)
  unitPrice       Decimal            @db.Decimal(10, 2)
  isPacked        Boolean            @default(false)
  isRejected      Boolean            @default(false)
  createdAt       DateTime           @default(now())

  @@index([orderId])
  @@index([inventoryItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SETTINGS (singleton table — global config)
// ─────────────────────────────────────────────────────────────────────────────

model GlobalSetting {
  id                 String   @id @default("global")
  userVisibilityRadiusKm Int  @default(5) // 1..10, set by ADMIN
  heroOnboardingFee  Int      @default(999) // One-time fee charged to heroes after agent verification (in INR)
  updatedAt          DateTime @updatedAt
}
